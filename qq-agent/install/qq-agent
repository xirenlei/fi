#!/usr/bin/env bash
# qq-agent:管理 NapCat / OpenCode / Agent 三个服务的命令行工具。
# 有用户级 systemd 时用 systemd 管理;没有时用简单的守护循环 + pid 文件。
set -uo pipefail

DATA_DIR="${QQ_AGENT_HOME:-$HOME/.config/qq-agent}"
# shellcheck disable=SC1091
[ -f "$DATA_DIR/install.env" ] && . "$DATA_DIR/install.env"
LOG_DIR="$DATA_DIR/logs"
RUN_DIR="$DATA_DIR/run"
SERVICES=(napcat opencode agent)

usage() {
  cat <<USAGE
用法: qq-agent <命令> [服务]
  start|stop|restart [napcat|opencode|agent|all]   启停服务(默认 all)
  status                                           查看各服务状态
  logs <napcat|opencode|agent>                     查看日志(Ctrl+C 退出)
  open                                             打开控制台
  run <服务>                                       前台运行(供 systemd 调用)
USAGE
}

have_systemd() { systemctl --user show-environment >/dev/null 2>&1; }

# 各服务的前台启动命令
run_service() {
  case "$1" in
    napcat)
      if command -v xvfb-run >/dev/null 2>&1; then
        exec xvfb-run -a "$QQ_BIN" --no-sandbox
      elif [ -n "${DISPLAY:-}" ]; then
        echo "没有 xvfb-run,改用当前桌面显示 $DISPLAY(QQ 窗口会出现在桌面上,不要关掉)" >&2
        exec "$QQ_BIN" --no-sandbox
      else
        echo "错误:没有 xvfb-run,也没有可用的桌面显示。请安装 xvfb 和 xauth。" >&2
        exit 1
      fi ;;
    opencode)
      mkdir -p "$WORKDIR" && cd "$WORKDIR" || exit 1
      exec "$OPENCODE_BIN" serve --hostname 127.0.0.1 --port 4096 ;;
    agent)
      cd "$APP_DIR/qq-agent" || exit 1
      exec "$BUN" run src/index.ts ;;
    *) echo "未知服务: $1" >&2; exit 1 ;;
  esac
}

# ---- 无 systemd 时的守护方式 ----
pid_file() { echo "$RUN_DIR/$1.pid"; }
pid_alive() { local f; f=$(pid_file "$1"); [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null; }

pid_start() {
  local s="$1"
  mkdir -p "$LOG_DIR" "$RUN_DIR"
  if pid_alive "$s"; then echo "$s 已在运行"; return 0; fi
  local self; self="$(readlink -f "$0")"
  QQ_AGENT_CTL="$self" setsid nohup bash -c "while true; do '$self' run $s; sleep 3; done" >>"$LOG_DIR/$s.log" 2>&1 &
  echo $! >"$(pid_file "$s")"
  echo "$s 已启动"
}

pid_stop() {
  local s="$1" f; f=$(pid_file "$s")
  if pid_alive "$s"; then
    local pid; pid=$(cat "$f")
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null
    echo "$s 已停止"
  fi
  rm -f "$f"
}

do_action() {
  local action="$1" s="$2"
  if have_systemd; then
    systemctl --user "$action" "qq-agent-$s.service"
  else
    case "$action" in
      start) pid_start "$s" ;;
      stop) pid_stop "$s" ;;
      restart) pid_stop "$s"; pid_start "$s" ;;
    esac
  fi
}

targets() {
  if [ -z "${1:-}" ] || [ "$1" = all ]; then printf '%s\n' "${SERVICES[@]}"; else echo "$1"; fi
}

cmd="${1:-}"
shift || true
case "$cmd" in
  start|stop|restart)
    for s in $(targets "${1:-}"); do do_action "$cmd" "$s"; done ;;
  status)
    for s in "${SERVICES[@]}"; do
      if have_systemd; then
        printf '%-9s %s\n' "$s" "$(systemctl --user is-active "qq-agent-$s.service" 2>/dev/null)"
      else
        pid_alive "$s" && printf '%-9s active\n' "$s" || printf '%-9s inactive\n' "$s"
      fi
    done ;;
  logs)
    [ -n "${1:-}" ] || { usage; exit 1; }
    exec tail -n 200 -f "$LOG_DIR/$1.log" ;;
  open)
    port=$(grep -o '"port": *[0-9]*' "$DATA_DIR/config.json" 2>/dev/null | tail -1 | grep -o '[0-9]*$')
    exec xdg-open "http://127.0.0.1:${port:-8765}" ;;
  run)
    [ -n "${1:-}" ] || { usage; exit 1; }
    run_service "$1" ;;
  *) usage; exit 1 ;;
esac
